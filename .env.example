# Bhoonidhi API Configuration
# Replace with your actual credentials from https://bhoonidhi.nrsc.gov.in/

BHOONIDHI_USER_ID=your_username_here
BHOONIDHI_PASSWORD=your_password_here

# Optional overrides
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_DOWNLOAD_DIR=./downloads
BHOONIDHI_MAX_CONCURRENT_DOWNLOADS=2
BHOONIDHI_REQUEST_TIMEOUT=60

